include ../Here4/hwdef.dat

# force Here4AKM to use the same bootloader as Here4
USE_BOOTLOADER_FROM_BOARD Here4

define SMPS_PWR_EXT_1V8
undef COMPASS

PF14 I2C4_SCL I2C4
PF15 I2C4_SDA I2C4

I2C_ORDER I2C4

COMPASS AK09916 I2C:0:0x0C false ROTATION_NONE

# set an offset for the sensor ID
# this is used to differentiate between the two compasses
# on the Here4 and Here4AKM boards and force recalibration
define SENSOR_ID_OFFSET 1
