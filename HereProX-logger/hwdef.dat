# HereProX logger variant: HerePro hardware with X20P, logging to eMMC from boot
include ../HerePro/hwdef.dat

undef HAL_LOGGING_ENABLED AP_INERTIALSENSOR_ENABLED
define HAL_LOGGING_ENABLED 1
define AP_INERTIALSENSOR_ENABLED 1
define AP_PERIPH_LOGGER 1
define HAL_LOGGING_FILE_BUFSIZE 400

# shares the HerePro bootloader (same APJ_BOARD_ID); no embedded bootloader image
define AP_BOOTLOADER_FLASHING_ENABLED 0
